{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/kg\" hook-context"
          }
        ]
      }
    ],
    "SessionStart": [
      {
